{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nain76/TID_simutrans/tools/infra-launcher/manifest/manifest.schema.json",
  "title": "Simutrans infra launcher server manifest",
  "type": "object",
  "required": [
    "schema_version",
    "servers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "servers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/server"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "download": {
      "type": "object",
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "server": {
      "type": "object",
      "required": [
        "id",
        "name",
        "address",
        "pakset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "変わらない識別子。お気に入りや記録ファイルで使う"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string",
          "description": "host または host:port。ポート省略時は 13353"
        },
        "status": {
          "enum": [
            "online",
            "offline",
            "maintenance",
            "unknown"
          ]
        },
        "players": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "engine": {
          "type": "object",
          "required": [
            "revision"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "builds": {
              "type": "object",
              "description": "キーは windows-x64 / windows-arm64 / linux-x64 / linux-arm64 / macos-x64 / macos-arm64",
              "additionalProperties": {
                "allOf": [
                  {
                    "$ref": "#/$defs/download"
                  },
                  {
                    "type": "object",
                    "required": [
                      "exe"
                    ],
                    "properties": {
                      "exe": {
                        "type": "string",
                        "description": "zip 展開先から見た実行ファイルの位置。zip の最上位がフォルダ1つだけの場合、そのフォルダは取り除いて展開される"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "pakset": {
          "type": "object",
          "required": [
            "name",
            "folder"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "folder": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.+-]+$",
              "description": "-objects に渡すフォルダ名。本体の実行ファイルと同じフォルダの中に、この名前で置かれる"
            },
            "url": {
              "$ref": "#/$defs/url",
              "description": "zip 方式: pakset の zip。zip の最上位がフォルダ1つだけの場合、そのフォルダは取り除いて展開される"
            },
            "sha256": {
              "$ref": "#/$defs/sha256",
              "description": "zip 方式: zip の SHA256"
            },
            "index_url": {
              "$ref": "#/$defs/url",
              "description": "ファイル一覧方式: index.json（index.schema.json）のアドレス。各ファイルは index.json と同じ場所に置く"
            },
            "index_sha256": {
              "$ref": "#/$defs/sha256",
              "description": "ファイル一覧方式: index.json の SHA256"
            }
          },
          "oneOf": [
            {
              "required": [
                "url",
                "sha256"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "index_url"
                    ]
                  },
                  {
                    "required": [
                      "index_sha256"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "index_url",
                "index_sha256"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "url"
                    ]
                  },
                  {
                    "required": [
                      "sha256"
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "url": {
      "type": "string",
      "description": "絶対アドレス（https://…）か、サーバーリストの場所から見た相対パス（pak128.japan/index.json など）"
    }
  }
}
