<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:InfraLauncher.App"
        x:Class="InfraLauncher.App.MainWindow"
        Title="Simutransランチャー"
        Width="900" Height="580" MinWidth="620" MinHeight="380">
  <DockPanel Margin="16">
    <!--上: タイトルと操作-->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="サーバー一覧" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button x:Name="AddButton" Content="追加" Click="OnAdd" />
        <Button x:Name="EditButton" Content="編集" IsEnabled="False" Click="OnEdit" />
        <Button x:Name="DeleteButton" Content="削除" IsEnabled="False" Click="OnDelete" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <CheckBox x:Name="FavoritesOnly" Content="お気に入りだけ表示" IsCheckedChanged="OnFilterChanged" />
        <Button x:Name="RefreshButton" Content="更新" Click="OnRefresh" />
        <Button Content="設定" Click="OnSettings" />
      </StackPanel>
    </Grid>

    <!--下: 接続ボタンと進み具合-->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <ProgressBar x:Name="Progress" IsVisible="False" Minimum="0" Maximum="100" Height="6" />
      <Grid ColumnDefinitions="*,Auto">
        <SelectableTextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button x:Name="CheckButton" Content="アップデートチェック" Padding="12,8" Click="OnCheck"
                  ToolTip.Tip="サーバーの最新の状態と手元のファイルを見比べて、同期が必要かを調べる（ダウンロードはしない）" />
          <Button x:Name="InstallOptionsButton" Content="インストール設定…" IsEnabled="False" Padding="12,8" Click="OnInstallOptions"
                  ToolTip.Tip="ダウンロード先と、本体のファイル構成（推奨／カスタム）を決める" />
          <Button x:Name="SyncButton" Content="同期" IsEnabled="False" Padding="20,8" Click="OnSync"
                  ToolTip.Tip="本体とpaksetをサーバーと同じ状態にする（起動はしない）" />
          <Button x:Name="LaunchButton" Content="起動" IsEnabled="False" Classes="accent" Padding="24,8" Click="OnLaunch"
                  ToolTip.Tip="simutransを起動してサーバーに接続する" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <Grid>
      <ListBox x:Name="ServerList" SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped">
        <ListBox.Styles>
          <!--選んだ行は、Windowsのアクセントカラー（緑など）で塗りつぶさず、薄い背景と左の線で示す。札の色が読めるように-->
          <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="#14808080" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#24808080" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#332f80ed" />
            <Setter Property="BorderBrush" Value="#2f80ed" />
          </Style>
          <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#442f80ed" />
            <Setter Property="BorderBrush" Value="#2f80ed" />
          </Style>
          <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style Selector="Border.badge > TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:ServerRow">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
              <Button Grid.RowSpan="4" Content="{Binding FavoriteGlyph}" IsEnabled="{Binding CanFavorite}" Opacity="{Binding FavoriteOpacity}"
                      Background="Transparent" BorderThickness="0" FontSize="20" Padding="4,0"
                      Margin="0,0,8,0" VerticalAlignment="Top"
                      ToolTip.Tip="お気に入りの印を付ける／外す" Click="OnToggleFavorite" />

              <!-- 1行目: 名前・稼働状況・人数-->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Classes="badge" Background="{Binding StatusBrush}" IsVisible="{Binding HasStatus}">
                  <TextBlock Text="{Binding StatusText}" />
                </Border>
                <Button Content="再確認" IsVisible="{Binding CanReprobe}" Click="OnReprobe" FontSize="11" Padding="6,1"
                        VerticalAlignment="Center" ToolTip.Tip="サーバーが動いているかを確かめ直す（ダウンロードはしない）" />
                <TextBlock Text="{Binding PlayersText}" IsVisible="{Binding HasPlayers}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding AddressText}" Opacity="0.7" VerticalAlignment="Center" />

              <!-- 2行目: お知らせ-->
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding HasMessage}"
                         TextWrapping="Wrap" Margin="0,6,0,0">
                <Run Text="お知らせ: " FontWeight="SemiBold" /><Run Text="{Binding Message}" />
              </TextBlock>

              <!-- 3行目: 同期の状態-->
              <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,8,0,0"
                    IsVisible="{Binding HasSyncLabel}">
                <Border Classes="badge" Background="{Binding SyncBrush}">
                  <TextBlock Text="{Binding SyncLabel}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding SyncDetail}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" />
              </Grid>

              <!-- 4行目: 細かい情報-->
              <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DetailText}" FontSize="12"
                         Opacity="0.65" TextWrapping="Wrap" Margin="0,6,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="460" />
    </Grid>
  </DockPanel>
</Window>
