<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:InfraLauncher.App"
        x:Class="InfraLauncher.App.InstallOptionsWindow"
        Title="インストール設定" Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

    <TextBlock Text="ダウンロード先" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBlock Text="simutrans 本体と pakset を入れるフォルダです。空欄なら「設定」の既定のフォルダを使います。本体は版ごとにこの中のフォルダに入ります。"
               TextWrapping="Wrap" Opacity="0.75" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="RootBox" TextChanged="OnRootChanged" />
      <Button Grid.Column="1" Content="参照…" Margin="8,0,0,0" Click="OnBrowse" />
    </Grid>
    <TextBlock x:Name="OneDriveWarning" Foreground="#c47a00" TextWrapping="Wrap" IsVisible="False"
               Text="OneDrive のフォルダの中です。数百 MB のファイルがクラウドに同期されたり、「オンライン専用」になって simutrans が読み込めなくなったりすることがあります。OneDrive の外（例: C:\Games\simutrans）をおすすめします。" />

    <TextBlock Text="ファイル構成" FontWeight="SemiBold" Margin="0,10,0,0" />
    <RadioButton x:Name="RecommendedRadio" GroupName="mode" Content="推奨（サーバー管理者のおすすめどおり。おすすめが変わると追従します）" IsCheckedChanged="OnModeChanged" />
    <RadioButton x:Name="CustomRadio" GroupName="mode" Content="カスタム（自分で選ぶ）" IsCheckedChanged="OnModeChanged" />
    <Border BorderThickness="1" BorderBrush="#40808080" CornerRadius="4" Padding="10,6" Margin="24,2,0,0">
      <ItemsControl x:Name="ComponentList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ComponentChoice">
            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEditable}" Margin="0,2">
              <TextBlock Text="{Binding Label}" />
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <TextBlock x:Name="PaksetNote" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" />
    <TextBlock x:Name="TotalText" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="ErrorText" Foreground="#d13438" TextWrapping="Wrap" IsVisible="False" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="キャンセル" Click="OnCancel" />
      <Button x:Name="OkButton" Content="保存" Classes="accent" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</Window>
