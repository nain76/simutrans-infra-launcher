<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InfraLauncher.App.SettingsWindow"
        Title="設定" Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="6">
    <TextBlock Text="プレイヤー名" FontWeight="SemiBold" />
    <TextBlock Text="サーバーに入ったときに、ほかのプレイヤーに表示される名前です。空欄ならsimutransの設定のままにします。サーバーから入れたsimutransに、起動するたびに書き込みます。"
               Opacity="0.75" TextWrapping="Wrap" />
    <TextBox x:Name="NicknameBox" Watermark="例: たろう" MaxLength="32" />
    <TextBlock x:Name="NicknameError" Foreground="#d13438" TextWrapping="Wrap" IsVisible="False" />

    <TextBlock Text="手元のsimutrans本体（任意）" FontWeight="SemiBold" Margin="0,12,0,0" />
    <TextBlock Text="共有されたサーバーリストに、このPC用のsimutrans本体が含まれていない場合に使います。手動プロファイルを追加するときの初期値にもなります。"
               Opacity="0.75" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="SimutransExe" Watermark="C:\Games\simutrans\simutrans.exe" />
      <Button Grid.Column="1" Content="参照…" Margin="8,0,0,0" Click="OnBrowse" />
    </Grid>

    <TextBlock Text="ダウンロード先の既定フォルダ（任意）" FontWeight="SemiBold" Margin="0,12,0,0" />
    <TextBlock Text="サーバーから入れるsimutrans本体とpaksetの置き場所です。空欄ならランチャーのデータフォルダの中に入れます。サーバーごとの「インストール設定」で個別に変えることもできます。"
               Opacity="0.75" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="InstallRoot" TextChanged="OnRootChanged" />
      <Button Grid.Column="1" Content="参照…" Margin="8,0,0,0" Click="OnBrowseRoot" />
    </Grid>
    <TextBlock x:Name="AdviceText" TextWrapping="Wrap" Opacity="0.75" />
    <Border x:Name="SyncWarning" IsVisible="False" Background="#33c47a00" BorderBrush="#c47a00" BorderThickness="1"
            CornerRadius="4" Padding="10,6">
      <TextBlock x:Name="SyncWarningText" TextWrapping="Wrap" FontWeight="SemiBold" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="キャンセル" Click="OnCancel" />
      <Button Content="保存" Classes="accent" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</Window>
