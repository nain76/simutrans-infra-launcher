<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InfraLauncher.App.ServerListWindow"
        Title="共有されたサーバーリスト" Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="6">
    <TextBlock x:Name="Note" TextWrapping="Wrap" Opacity="0.75" IsVisible="False" Margin="0,0,0,8" />

    <TextBlock Text="表示名" FontWeight="SemiBold" />
    <TextBox x:Name="NameBox" Watermark="例: 友達グループのサーバー" />

    <TextBlock Text="配信アドレス" FontWeight="SemiBold" Margin="0,10,0,0" />
    <TextBlock Text="サーバー管理者から教えてもらったアドレスを貼り付けてください。受け取ったファイル（.json）がある場合は「ファイルを選択」で選べます。"
               TextWrapping="Wrap" Opacity="0.75" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="UrlBox" Watermark="https://example.ddns.net/simutrans/manifest.json" />
      <Button Grid.Column="1" Content="ファイルを選択…" Margin="8,0,0,0" Click="OnBrowse" />
    </Grid>

    <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsVisible="False" Margin="0,6,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="キャンセル" Click="OnCancel" />
      <Button x:Name="SaveButton" Content="確認して保存" Classes="accent" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</Window>
