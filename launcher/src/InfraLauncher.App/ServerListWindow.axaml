<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InfraLauncher.App.ServerListWindow"
        Title="共有されたサーバーリスト" Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="6">
    <TextBlock x:Name="Note" TextWrapping="Wrap" Opacity="0.75" IsVisible="False" Margin="0,0,0,8" />

    <TextBlock Text="表示名" FontWeight="SemiBold" />
    <TextBox x:Name="NameBox" Watermark="例: 友達グループのサーバー" />

    <TextBlock Text="配信アドレス" FontWeight="SemiBold" Margin="0,10,0,0" />
    <TextBlock Text="サーバー管理者から教えてもらったアドレス（https:// で始まるもの）を貼り付けてください。"
               TextWrapping="Wrap" Opacity="0.75" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="UrlBox" Watermark="https://example.ddns.net:8443/manifest.json" />
      <Button Grid.Column="1" Content="ファイルを選択…" Margin="8,0,0,0" Click="OnBrowse" />
    </Grid>

    <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsVisible="False" Margin="0,6,0,0" />

    <!-- 確認コードの見比べ。署名の仕組みを知らなくても、管理者から聞いた文字列と同じかどうかだけ答えればよいようにする -->
    <Border x:Name="CodePanel" IsVisible="False" Margin="0,10,0,0" Padding="12" CornerRadius="6"
            BorderThickness="1" BorderBrush="#808080">
      <StackPanel Spacing="8">
        <TextBlock Text="確認コードを見比べてください" FontWeight="SemiBold" />
        <TextBlock x:Name="CodeIntro" TextWrapping="Wrap" />
        <SelectableTextBlock x:Name="CodeText" FontFamily="Consolas,Menlo,monospace" FontSize="22"
                             FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4" />
        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                   Text="同じなら、このサーバーリストが本当にサーバー管理者のものだと確かめられます。以後ランチャーは、誰かが配信しているファイルを書き換えても気づいて止めます。確認コードは秘密の情報ではありません。" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
          <Button x:Name="LaterButton" Content="まだ聞いていない（あとで）" Click="OnCodeLater" />
          <Button Content="違う" Click="OnCodeDifferent" />
          <Button Content="同じ（登録する）" Classes="accent" Click="OnCodeSame" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel x:Name="SaveButtons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="キャンセル" Click="OnCancel" />
      <Button x:Name="SaveButton" Content="確認して保存" Classes="accent" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</Window>
